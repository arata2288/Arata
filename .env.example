# Telegram (получить токен у @BotFather)
TELEGRAM_BOT_TOKEN=
# ID чата, в который шлются алерты от мониторинга (опционально, теперь есть /set_alert)
ALERT_CHAT_ID=
# Telegram user ID админа. Если задан — бот приватный (whitelist),
# управляется командами /allow, /disallow, /allowed.
# Узнать свой ID: написать боту команду /myid.
ADMIN_USER_ID=

# Plane (https://plane.so / self-hosted)
PLANE_URL=https://plane.example.com
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# URL самого бота для self-healthcheck (по умолчанию локальный)
BOT_SERVER_URL=http://localhost:3000/health
